<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 et anterieurs : contenu exclu de la sauvegarde automatique.
  Les SharedPreferences portent le mot de passe CMS : jamais sauvegardees.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="sharedpref" />
    <exclude domain="database" />
    <exclude domain="file" />
</full-backup-content>
