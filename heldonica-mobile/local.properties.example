## Configuration Heldonica Mobile
# Chemin vers votre Android SDK (adaptez selon votre OS)
sdk.dir=C\:\\Users\\farin\\AppData\\Local\\Android\\Sdk

# Configuration de connexion à l'API Heldonica CMS
cms.baseUrl=https://www.heldonica.fr

# Mot de passe CMS — celui defini dans Vercel (variable CMS_PASSWORD).
# Ce fichier d'exemple portait la valeur `heldonica2026`, l'ancien repli code en
# dur dans lib/cms-auth.ts. Ce repli a ete supprime : un depot public ne peut
# pas contenir un mot de passe qui ouvre l'administration. Laisse le champ vide
# ici et renseigne-le dans local.properties, qui n'est pas versionne.
cms.password=
 
# URL du Heldonica Brain (serveur IA local sur station PC)
# En local Wi-Fi: http://10.10.145.61:8440 ou via tunnel HTTPS externe
brain.baseUrl=http://10.10.145.61:8440

# URL de la console Brain affichee dans l'onglet Cerveau de StudioActivity.
# En Wi-Fi maison : l'IP locale du PC + :8475 (ex. http://192.168.1.20:8475).
# Laisse vide pour afficher la marche a suivre dans l'appli.
# La connexion a la console se fait a la main (mot de passe Brain),
# aucun secret n'est stocke dans l'APK pour cet onglet.
brain.webUrl=
